CREATE TABLE Questionnaire (
    id INTEGER PRIMARY KEY AUTOINCREMENT,
    event_slug TEXT,
    type TEXT,
    json_data TEXT,
    position INTEGER,
    server_id INTEGER
);
CREATE INDEX Questionnaire_server_id_index ON Questionnaire (server_id);
CREATE TABLE Questionnaire_Item (
    ItemId INTEGER REFERENCES Item (id) ON DELETE CASCADE,
    QuestionnaireId INTEGER REFERENCES Questionnaire (id) ON DELETE CASCADE,
    PRIMARY KEY (ItemId, QuestionnaireId)
);
CREATE INDEX Questionnaire_Item_ItemId_index ON Questionnaire_Item (ItemId);
CREATE INDEX Questionnaire_Item_QuestionId_index ON Questionnaire_Item (QuestionnaireId);
