CREATE TABLE Question_Item (  -- Deprecated, Remove after pretix 2026.10 is no longer supported
    ItemId INTEGER REFERENCES Item (id) ON DELETE CASCADE,
    QuestionId INTEGER REFERENCES Question (id) ON DELETE CASCADE,
    PRIMARY KEY (ItemId, QuestionId)
);
CREATE INDEX Question_Item_ItemId_index ON Question_Item (ItemId);
CREATE INDEX Question_Item_QuestionId_index ON Question_Item (QuestionId);
